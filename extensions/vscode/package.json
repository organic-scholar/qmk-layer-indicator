{
  "name": "qmk-layer-indicator",
  "displayName": "QMK Layer Indicator",
  "description": "Updates the VS Code cursor style from QMK layer events.",
  "version": "0.1.0",
  "publisher": "organic-scholar",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "QMK Layer Indicator",
      "properties": {
        "qmkLayerIndicator.webSocketUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:51837",
          "description": "Local QMK Layer Indicator WebSocket URL."
        },
        "qmkLayerIndicator.layerCursorStyles": {
          "type": "object",
          "default": {
            "0": "line",
            "1": "block",
            "2": "underline"
          },
          "description": "Maps QMK layer numbers to VS Code cursor styles.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "line",
              "block",
              "underline",
              "line-thin",
              "block-outline",
              "underline-thin"
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0",
    "@types/ws": "^8.5.13"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
